<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Laboratorio 07</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
  <link rel="stylesheet" href="/css/app.css">
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
  <script defer src="/js/app.js"></script>
</head>
<body data-page="<%= page %>" data-protected="<%= protectedPage %>">
  <nav class="teal darken-3" aria-label="Navegación principal"><div class="nav-wrapper container">
    <a class="brand" href="<%= protectedPage ? '/dashboard' : '/signIn' %>">LAB / 07</a>
    <div class="nav-links">
    <% if (protectedPage) { %>
      <a href="/dashboard">Inicio</a><a href="/profile">Mi cuenta</a><a href="/admin" id="admin-link" hidden>Usuarios</a>
      <button id="logout" class="btn-flat white-text" type="button">Salir</button>
    <% } else { %><a href="/signIn">Ingresar</a><a href="/signUp">Registrarse</a><% } %>
    </div>
  </div></nav>
  <main class="container <%= ['signIn', 'signUp'].includes(page) ? 'auth-container' : '' %>">
    <p class="eyebrow">EXPRESS · MONGODB · CUENTAS</p>
    <h1><%= title %></h1>
    <div id="message" role="status" aria-live="polite" hidden></div>
    <% if (page === 'signIn') { %>
      <p class="intro">Ingresa para acceder a tu espacio personal.</p>
      <form id="signin-form" class="card-panel">
        <div class="input-field"><input id="email" name="email" type="email" autocomplete="email" required><label for="email">Correo electrónico</label></div>
        <div class="input-field"><input id="password" name="password" type="password" autocomplete="current-password" required><label for="password">Contraseña</label></div>
        <button class="btn teal darken-2" type="submit">Iniciar sesión</button>
        <p>¿No tienes una cuenta? <a href="/signUp">Regístrate</a></p>
      </form>
    <% } else if (page === 'signUp' || page === 'profile') { %>
      <% if (page === 'profile') { %><section id="user-data" class="card-panel" aria-label="Datos actuales">Cargando tus datos…</section><% } %>
      <form id="<%= page === 'signUp' ? 'signup-form' : 'profile-form' %>" class="card-panel">
        <h2><%= page === 'signUp' ? 'Tus datos' : 'Editar mis datos' %></h2>
        <%- include('fields', { editing: page === 'profile' }) %>
        <button class="btn teal darken-2" type="submit"><%= page === 'signUp' ? 'Crear cuenta' : 'Guardar cambios' %></button>
      </form>
    <% } else if (page === 'dashboard') { %>
      <p class="intro">Bienvenido, aquí están tus datos.</p>
      <section id="user-data" class="card-panel">Cargando tus datos…</section>
      <a class="btn teal darken-2" href="/profile">Editar mi cuenta</a>
    <% } else if (page === 'admin') { %>
      <p class="intro">Consulta las cuentas registradas y su información.</p>
      <div class="card-panel table-scroll"><table class="striped"><thead><tr><th>Nombre</th><th>Correo</th><th>Roles</th><th>Registro</th><th>Detalle</th></tr></thead><tbody id="users"><tr><td colspan="5">Cargando usuarios…</td></tr></tbody></table></div>
    <% } else if (page === 'detail') { %>
      <section id="user-data" class="card-panel">Cargando usuario…</section><a href="/admin" class="btn teal darken-2">Volver a usuarios</a>
    <% } else { %>
      <section class="card-panel"><p class="error-code"><%= page %></p><p><%= page === '403' ? 'Tu rol no tiene permisos para acceder a esta página.' : 'La página que buscas no existe.' %></p>
      <a href="<%= protectedPage ? '/dashboard' : '/signIn' %>" class="btn teal darken-2">Volver al inicio</a></section>
    <% } %>
    <noscript><p>Activa JavaScript para iniciar sesión y gestionar tu cuenta.</p></noscript>
  </main>
  <footer class="container">Laboratorio 07 · Aplicación de gestión de usuarios</footer>
</body>
</html>
